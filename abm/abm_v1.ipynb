    "        \"fulmination\": {\"damage\": 50, \"cooldown\": 19.0, \"stamina_cost\": 35, \"range\": 10, \"startup\": 0.2, \"endlag\": 0.3, \"hitstun\": 1, \"tag\": \"punish\", \"atk_type\": \"heavy\", \"tracking\": False, \"bypass_invuln\": True},\n",
    "        \"rift_rush\": {\"damage\": 20, \"cooldown\": 14.0, \"stamina_cost\": 10, \"range\": 50, \"startup\": 0.01, \"endlag\": 0.05, \"hitstun\": 0.0, \"tag\": \"defensive\", \"atk_type\": \"light\", \"tracking\": True, \"teleport_dist\": 50},\n",
