    "                masks[idx + 2] = (\n",
    "                    agent.cooldowns.get(name, 0) <= 0\n",
    "                    and agent.stamina >= move.get(\"stamina_cost\", 0)\n",
    "                )\n",
    " \n",
    "        if not np.any(masks):\n",
    "            masks[0] = True\n",
    "        return masks\n",
    " \n",
    "    def _get_obs(self, agent_idx=0):\n",
    "        p_self = self.model.agents[agent_idx]\n",
    "        p_opp = self.model.agents[1 - agent_idx]\n",
    "        return np.array([\n",
    "            float(self.model.distance),\n",
    "            float(p_self.health),\n",
    "            float(p_self.stamina),\n",
    "            float(p_opp.health),\n",
    "            float(p_opp.stamina)\n",
    "        ], dtype=np.float32)\n",
    " \n",
    "    def reset(self, seed=None, options=None):\n",
    "        super().reset(seed=seed)\n",
    "        self.model = DuelModel(crusader_a=self.crusader_a, crusader_b=self.crusader_b, seed=seed)\n",
    "        return self._get_obs(agent_idx=0), {}\n",
    " \n",
    "    def step(self, action):\n",
    "        p1 = self.model.agents[0]\n",
    "        p2 = self.model.agents[1]\n",
    "        p1_prev_hp = p1.health\n",
    "        p2_prev_hp = p2.health\n",
    " \n",
    "        self._apply_action(p1, p2, action)\n",
    " \n",
    "        if self.opponent_policy is not None:\n",
    "            p2_obs = self._get_obs(agent_idx=1)\n",
    "            p2_mask = self.action_masks(agent_idx=1)\n",
    "            p2_action, _ = self.opponent_policy.predict(p2_obs, action_masks=p2_mask)\n",
    "            self._apply_action(p2, p1, p2_action)\n",
    " \n",
    "        self.model.step()\n",
    " \n",
    "        obs = self._get_obs(agent_idx=0)\n",
    "        terminated = self.model.fight_over()\n",
    "        truncated = self.model.steps >= self.max_steps\n",
    " \n",
    "        damage_dealt = p2_prev_hp - p2.health\n",
    "        damage_taken = p1_prev_hp - p1.health\n",
    "        reward = (damage_dealt * 1.5) - (damage_taken * 1.0)\n",
    " \n",
    "        if self.model.distance > 0:\n",
    "            reward -= 0.01 * self.model.distance\n",
    " \n",
    "        if not p2.alive():\n",
    "            reward += 100.0\n",
    "        elif not p1.alive():\n",
    "            reward -= 100.0\n",
    " \n",
    "        return obs, reward, terminated, truncated, {\"steps\": self.model.steps}\n",
    " \n",
    "    def _apply_action(self, agent, target, action):\n",
    "        if agent.is_busy():\n",
    "            return\n",
    " \n",
    "        if action == 0:\n",
    "            if agent.stamina > agent.max_stamina / 2:\n",
    "                approach_speed = agent.run_speed * TICK_RATE\n",
    "                agent.stamina -= 1\n",
    "            else:\n",
    "                approach_speed = agent.walk_speed * TICK_RATE\n",
    "            self.model.distance = max(0, self.model.distance - approach_speed)\n",
    "        elif action == 1:\n",
    "            if (agent.cooldowns.get(\"_m1_cd\", 0) <= 0\n",
    "                    and agent.stamina >= agent.m1_config.get(\"stamina_cost\", 0)):\n",
    "                agent.stamina -= agent.m1_config[\"stamina_cost\"]\n",
    "                agent.use_m1()\n",
    "        else:\n",
    "            move_names = list(agent.moves.keys())\n",
    "            move_idx = action - 2\n",
    "            if move_idx < len(move_names):\n",
    "                move_name = move_names[move_idx]\n",
    "                move_data = agent.moves[move_name]\n",
    "                if agent.cooldowns.get(move_name, 0) <= 0 and agent.stamina >= move_data.get(\"stamina_cost\", 0):\n",
    "                    agent.start_move(move_name)"
   ]
