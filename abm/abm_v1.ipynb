    "}\n",
    "\n",
    "M1_CONFIG = {\n",
    "    \"Redd\": {\"base_dmg\": 5, \"range\": 3.5, \"stamina_cost\": 0, \"combo_extension\": 3.0, \"startup_delays\": [0.2, 0.2, 0.2, 0.2], \"cooldowns\": [0.399, 0.399, 0.399, 2.249], \"hitstun_times\": [0.4, 0.4, 0.4, 0.0]},\n",
    "    \"Yello\": {\"base_dmg\": 4.85, \"range\": 3.5, \"stamina_cost\": 0, \"combo_extension\": 3.0, \"startup_delays\": [0.15, 0.15, 0.15, 0.3], \"cooldowns\": [0.299, 0.299, 0.299, 1.999], \"hitstun_times\": [0.3, 0.3, 0.3, 0.1]},\n",
    "    \"Gleen\": {\"base_dmg\": 4.95, \"range\": 3.5, \"stamina_cost\": 0, \"combo_extension\": 3.0, \"startup_delays\": [0.25, 0.25, 0.25, 0.25], \"cooldowns\": [0.499, 0.499, 0.499, 2.499], \"hitstun_times\": [0.4, 0.4, 0.4, 0.0]},\n",
    "    \"Bluee\": {\"base_dmg\": 5, \"range\": 3.5, \"stamina_cost\": 0, \"combo_extension\": 3.0, \"startup_delays\": [0.2, 0.2, 0.2, 0.2], \"cooldowns\": [0.399, 0.399, 0.399, 2.249], \"hitstun_times\": [0.4, 0.4, 0.4, 0.0]},\n",
    "}\n",
    "\n",
    "CRUSADER_STATS = {\n",
    "    \"Redd\":  {\"max_health\": 300, \"max_stamina\": 150, \"walk_speed\": 16, \"run_speed\": 24},\n",
    "    \"Yello\": {\"max_health\": 250, \"max_stamina\": 175, \"walk_speed\": 15.5, \"run_speed\": 25},\n",
    "    \"Gleen\": {\"max_health\": 325, \"max_stamina\": 100, \"walk_speed\": 17, \"run_speed\": 22},\n",
    "    \"Bluee\": {\"max_health\": 275, \"max_stamina\": 125, \"walk_speed\": 16.5, \"run_speed\": 23},\n",
    "}\n",
    "\n",
    "# some extra classes were made to sloppily account for the special mechanics of their respective moves\n",
    "class ActiveField:\n",
    "    def __init__(self, owner, dot_dmg, interval_sec, duration_sec, start_r, end_r, start_tick):\n",
    "        self.owner = owner\n",
    "        self.dot_dmg = dot_dmg\n",
    "        self.interval_ticks = max(1, int(interval_sec / TICK_RATE))\n",
    "        self.duration_ticks = int(duration_sec / TICK_RATE)\n",
    "        self.start_r = start_r\n",
    "        self.end_r = end_r\n",
    "        self.start_tick = start_tick\n",
    "        self.last_tick_applied = start_tick\n",
    "\n",
    "    def is_active(self, current_tick):\n",
    "        return current_tick < (self.start_tick + self.duration_ticks)\n",
    "\n",
    "    def current_radius(self, current_tick):\n",
    "        if self.duration_ticks == 0:\n",
    "            return self.end_r\n",
    "        elapsed_ratio = min(1.0, (current_tick - self.start_tick) / self.duration_ticks)\n",
    "        return self.start_r + (self.end_r - self.start_r) * elapsed_ratio\n",
    "\n",
    "\n",
    "class ActiveAnimalInstinct:\n",
    "    def __init__(self, owner, dot_dmg, interval_sec, max_ticks, hitbox_r, start_tick):\n",
    "        self.owner = owner\n",
    "        self.dot_dmg = dot_dmg\n",
    "        self.interval_ticks = max(1, int(interval_sec / TICK_RATE))\n",
    "        self.max_ticks = max_ticks\n",
    "        self.ticks_done = 0\n",
    "        self.hitbox_r = hitbox_r\n",
    "        self.start_tick = start_tick\n",
    "        self.last_tick_applied = start_tick\n",
    "\n",
    "    def is_active(self):\n",
    "        return self.ticks_done < self.max_ticks\n",
    "\n",
    "\n",
    "class ActiveBreach:\n",
    "    def __init__(self, owner, run_speed, duration_sec, range_, start_tick):\n",
    "        self.owner = owner\n",
    "        self.run_speed = run_speed\n",
    "        self.duration_ticks = max(1, int(duration_sec / TICK_RATE))\n",
    "        self.range_ = range_\n",
    "        self.start_tick = start_tick\n",
    "        self.resolved = False\n",
    "\n",
    "    def is_active(self, current_tick):\n",
    "        return not self.resolved and (current_tick - self.start_tick) < self.duration_ticks\n",
    "\n",
    "\n",
    "class ActiveVortex:\n",
    "    def __init__(self, owner, dot_dmg, interval_sec, duration_sec, hit_radius, start_tick):\n",
    "        self.owner = owner\n",
    "        self.dot_dmg = dot_dmg\n",
    "        self.interval_ticks = max(1, int(interval_sec / TICK_RATE))\n",
    "        self.duration_ticks = max(1, int(duration_sec / TICK_RATE))\n",
    "        self.hit_radius = hit_radius\n",
    "        self.start_tick = start_tick\n",
    "        self.last_tick_applied = start_tick\n",
    "\n",
    "    def is_active(self, current_tick):\n",
    "        return (current_tick - self.start_tick) < self.duration_ticks\n",
    "\n",
    "\n",
    "class Crusader(Agent):\n",
    "    TAG_PRIORITY = {# tag priorities were my solution to the agents' lack of intuition regarding their usage of the moves in general; i was only able to tell that this was an issue via a personal "Sixth Sense," but i added move tallying in later versions of this ABM\n",
    "        \"poke\": lambda self, target: True,\n",
    "        \"punish\": lambda self, target: self.opponent_is_winding_up() or self.model.distance <= 15,\n",
    "        \"combo_starter\": lambda self, target: target.stunned_until <= self.model.steps,\n",
    "        \"defensive\": lambda self, target: self.opponent_is_winding_up() or self.health < self.max_health * 0.3,\n",
    "    }\n",
    "\n",
    "    def __init__(self, model, crusader_name):\n",
    "        super().__init__(model)\n",
    "        stats = CRUSADER_STATS[crusader_name]\n",
    "        self.crusader_name = crusader_name\n",
    "        self.health = stats[\"max_health\"]\n",
    "        self.max_health = stats[\"max_health\"]\n",
    "        self.stamina = stats[\"max_stamina\"]\n",
    "        self.max_stamina = stats[\"max_stamina\"]\n",
    "        self.walk_speed = stats[\"walk_speed\"]\n",
    "        self.run_speed = stats[\"run_speed\"]\n",
    "        self.stunned_until = 0\n",
    "        self.locked_until = 0\n",
    "        self.invulnerable_until = 0  # immunity: damage itself is blocked (Sixth Sense)\n",
    "        self.resistant_until = 0     # resistance: damage still lands, stun/knockback/interrupt suppressed\n",
    "        self.dash_cooldown_until = 0\n",
    "        self.sanity_lost = 0.0\n",
    "\n",
    "        self.pending_move = None\n",
    "        self.pending_resolve_at = 0\n",
    "        self.active_instinct = None\n",
    "        self.active_breach = None\n",
    "        self.active_vortex = None\n",
    "\n",
    "        self.moves = MOVES[crusader_name]\n",
    "        self.cooldowns = {name: 0 for name in self.moves}\n",
    "        self.cooldowns[\"_m1_cd\"] = 0\n",
    "\n",
    "        self.m1_config = M1_CONFIG[crusader_name]\n",
    "        self.m1_count = 0\n",
    "        self.m1_last_use = -9999\n",
    "\n",
    "    @property\n",
    "    def health_lost(self):\n",
    "        return self.max_health - self.health\n",
    "\n",
    "    def alive(self):\n",
    "        return self.health > 0\n",
    "\n",
    "    def is_busy(self):\n",
    "        return self.model.steps < self.stunned_until or self.model.steps < self.locked_until\n",
    "\n",
    "    def opponent(self):\n",
    "        others = [a for a in self.model.agents if a is not self]\n",
    "        return others[0] if others else None\n",
    "\n",
    "    def opponent_is_winding_up(self):\n",
    "        target = self.opponent()\n",
    "        return target is not None and target.pending_move is not None\n",
    "\n",
    "    def opponent_is_invulnerable(self):\n",
    "        target = self.opponent()\n",
    "        return target is not None and target.invulnerable_until > self.model.steps\n",
    "\n",
    "    def can_dash(self):\n",
    "        return (\n",
    "            self.model.steps >= self.dash_cooldown_until\n",
    "            and self.stamina >= DASH_CONFIG[\"stamina_cost\"]\n",
    "            and not self.is_busy()\n",
    "        )\n",
    "\n",
    "    def perform_dash(self):\n",
    "        self.stamina -= DASH_CONFIG[\"stamina_cost\"]\n",
    "        cd_ticks = int(DASH_CONFIG[\"cooldown\"] / TICK_RATE)\n",
    "        invuln_ticks = int(DASH_CONFIG[\"invuln_duration\"] / TICK_RATE)\n",
    "\n",
    "        self.dash_cooldown_until = self.model.steps + cd_ticks\n",
    "        self.invulnerable_until = self.model.steps + invuln_ticks\n",
    "\n",
    "        self.model.distance += DASH_CONFIG[\"distance\"]\n",
    "        self.pending_move = None\n",
    "\n",
    "    def apply_hit(self, damage, hitstun_sec=0.0, knockback_type=None, ignore_invuln=False):\n",
    "        # true immunity (Sixth Sense, dash i-frames) blocks the hit.\n",
    "        if not ignore_invuln and self.model.steps < self.invulnerable_until:\n",
    "            return False\n",
    "\n",
    "        # damage always lands past this point; resistance never blocks it.\n",
    "        self.health -= damage\n",
    "\n",
    "        resistant = self.model.steps < self.resistant_until\n",
    "        if not resistant:\n",
    "            if self.pending_move:\n",
    "                self.pending_move = None\n",
    "                self.locked_until = self.model.steps\n",
    "\n",
    "            self.m1_count = 0\n",
    "\n",
    "            if hitstun_sec > 0:\n",
    "                hitstun_ticks = int(hitstun_sec / TICK_RATE)\n",
    "                self.stunned_until = max(self.stunned_until, self.model.steps + hitstun_ticks)\n",
    "\n",
    "            if knockback_type and knockback_type in KNOCKBACK_DISTANCES:\n",
    "                self.model.distance = max(0.0, self.model.distance + KNOCKBACK_DISTANCES[knockback_type])\n",
    "\n",
    "        return True\n",
    "\n",
    "    def get_dynamic_move_specs(self, move_name):\n",
    "        base_move = None\n",
    "        for moves in MOVES.values():\n",
    "            if move_name in moves:\n",
    "                base_move = moves[move_name].copy()\n",
    "                break\n",
    "\n",
    "        if base_move is None:\n",
    "            raise KeyError(f\"Move '{move_name}' not found in MOVES dictionary.\")\n",
    "\n",
    "        if self.crusader_name == \"Redd\":\n",
    "            loss_ratio = self.health_lost / self.max_health\n",
    "            if move_name == \"hero's_fist\":\n",
    "                damage_multiplier = 1.0 + (loss_ratio ** 2)\n",
    "                base_move[\"base_inner_damage\"] *= damage_multiplier\n",
    "                base_move[\"base_shockwave_damage\"] *= damage_multiplier\n",
    "                self.sanity_lost += 0.05\n",
    "            elif move_name == \"sixth_sense\":\n",
    "                base_move[\"invuln_duration\"] = 1.5 + (1.5 * (loss_ratio ** 2))\n",
    "                self.sanity_lost += 0.05\n",
    "\n",
    "        elif self.crusader_name == \"Gleen\":\n",
    "            if move_name == \"animal_instinct\":\n",
    "                hp_ratio = self.health / self.max_health\n",
    "                base_move[\"base_dot_damage\"] = 8.0 + (8.0 * hp_ratio)\n",
    "                self.sanity_lost += 0.05\n",
    "\n",
    "        return base_move\n",
    "\n",
    "    def m1_next_stage(self):\n",
    "        ext = int(self.m1_config[\"combo_extension\"] / TICK_RATE)\n",
    "        if self.model.steps - self.m1_last_use <= ext:\n",
    "            return min(4, self.m1_count + 1)\n",
    "        return 1\n",
    "\n",
    "    def m1_stage_damage(self, stage):\n",
    "        return self.m1_config[\"base_dmg\"] + 0.5 * (stage - 1) ** 2\n",
    "\n",
    "    def use_m1(self):\n",
    "        stage = self.m1_next_stage()\n",
    "        self.m1_count = stage\n",
    "        self.m1_last_use = self.model.steps\n",
    "\n",
    "        startup_sec = self.m1_config[\"startup_delays\"][stage - 1]\n",
    "        startup_ticks = max(1, int(startup_sec / TICK_RATE))\n",
    "        stage_cd_sec = self.m1_config[\"cooldowns\"][stage - 1]\n",
    "        self.cooldowns[\"_m1_cd\"] = startup_ticks + int(stage_cd_sec / TICK_RATE)\n",
    "\n",
    "        self.locked_until = self.model.steps + startup_ticks\n",
    "        self.pending_move = f\"m1_stage_{stage}\"\n",
    "        self.pending_resolve_at = self.model.steps + startup_ticks\n",
    "\n",
    "    def resolve_m1(self, stage):\n",
    "        target = self.opponent()\n",
    "        if target and target.alive() and self.model.distance <= self.m1_config[\"range\"]:\n",
    "            damage = self.m1_stage_damage(stage)\n",
    "            hitstun_sec = self.m1_config[\"hitstun_times\"][stage - 1]\n",
    "            hit_success = target.apply_hit(damage=damage, hitstun_sec=hitstun_sec, knockback_type=\"light\")\n",
    "            if hit_success and stage >= 4:\n",
    "                self.m1_count = 0\n",
    "        else:\n",
    "            self.m1_count = 0\n",
    "            self.cooldowns[\"_m1_cd\"] += int(0.1 / TICK_RATE)\n",
    "        self.pending_move = None\n",
    "\n",
    "    def choose_move(self):\n",
    "        distance = self.model.distance\n",
    "        target = self.opponent()\n",
    "\n",
    "        available = {\n",
    "            name: data for name, data in self.moves.items()\n",
    "            if self.cooldowns[name] <= 0\n",
    "            and self.stamina >= data[\"stamina_cost\"]\n",
    "            and distance <= data.get(\"range\", data.get(\"query_radius\", data.get(\"shockwave_range\", 0)))\n",
    "        }\n",
    "\n",
    "        if not available:\n",
    "            return None\n",
    "\n",
    "        priority_order = [\"defensive\", \"punish\", \"combo_starter\", \"poke\"]\n",
    "        for tag_name in priority_order:\n",
    "            condition_func = self.TAG_PRIORITY.get(tag_name)\n",
    "            if condition_func and condition_func(self, target):\n",
    "                matching_moves = [name for name, data in available.items() if data.get(\"tag\") == tag_name]\n",
    "                if matching_moves:\n",
    "                    return random.choice(matching_moves)\n",
    "\n",
    "        return random.choice(list(available.keys()))\n",
    "\n",
    "    def start_move(self, move_name):\n",
    "        move = self.get_dynamic_move_specs(move_name)\n",
    "        self.stamina -= move[\"stamina_cost\"]\n",
    "        self.cooldowns[move_name] = int(move[\"cooldown\"] / TICK_RATE)\n",
    "\n",
    "        if move.get(\"self_effect\") == \"immune\":\n",
    "            invuln_sec = move.get(\"invuln_duration\", 1.5)\n",
    "            self.invulnerable_until = self.model.steps + int(invuln_sec / TICK_RATE)\n",
    "\n",
    "        startup_ticks = int(move.get(\"startup\", 0) / TICK_RATE)\n",
    "        if startup_ticks <= 0:\n",
    "            self.resolve_move(move_name)\n",
    "        else:\n",
    "            self.pending_move = move_name\n",
    "            self.pending_resolve_at = self.model.steps + startup_ticks\n",
    "            self.locked_until = self.pending_resolve_at\n",
    "\n",
    "# massive, sloppy selection tree used to accommodate the behavior of the more dynamic moves\n",
    "    def resolve_move(self, move_name):\n",
    "        if move_name.startswith(\"m1_stage_\"):\n",
    "            stage = int(move_name.split(\"_\")[-1])\n",
    "            self.resolve_m1(stage)\n",
    "            return\n",
    "\n",
    "        move = self.get_dynamic_move_specs(move_name)\n",
    "        target = self.opponent()\n",
    "        self.pending_move = None\n",
    "\n",
    "        if target is None or not target.alive():\n",
    "            return\n",
    "\n",
    "        current_distance = self.model.distance\n",
    "\n",
    "        if move_name == \"hero's_fist\":\n",
    "            if current_distance <= move[\"inner_range\"]:\n",
    "                target.apply_hit(damage=move[\"base_inner_damage\"], hitstun_sec=move[\"hitstun\"], knockback_type=\"heavy\")\n",
    "            elif current_distance <= move[\"shockwave_range\"]:\n",
    "                target.apply_hit(damage=move[\"base_shockwave_damage\"], knockback_type=\"light\")\n",
    "\n",
    "        elif move_name == \"sacred_circle\":\n",
    "            field = ActiveField(\n",
    "                owner=self, dot_dmg=move[\"dot_damage\"], interval_sec=move[\"dot_interval\"],\n",
    "                duration_sec=move[\"total_duration\"], start_r=move[\"start_radius\"], end_r=move[\"end_radius\"],\n",
    "                start_tick=self.model.steps\n",
    "            )\n",
    "            self.model.active_fields.append(field)\n",
    "\n",
    "        elif move_name == \"fulmination\":\n",
    "            if current_distance <= move[\"range\"]:\n",
    "                target.apply_hit(\n",
    "                    damage=move[\"damage\"], hitstun_sec=move[\"hitstun\"],\n",
    "                    knockback_type=move.get(\"atk_type\"),\n",
    "                    ignore_invuln=move.get(\"bypass_invuln\", False)\n",
    "                )\n",
    "\n",
    "        elif move_name == \"rift_rush\":\n",
    "            self.model.distance = max(0, self.model.distance - move.get(\"teleport_dist\", 50))\n",
    "            if self.model.distance <= move[\"range\"]:\n",
    "                target.apply_hit(damage=move[\"damage\"], hitstun_sec=move[\"hitstun\"], knockback_type=move.get(\"atk_type\"))\n",
    "\n",
    "        elif move_name == \"copy\":\n",
    "            crusader_choice = random.choice([\"Redd\", \"Yello\", \"Gleen\"])\n",
    "            copied_moves = list(MOVES[crusader_choice].keys())\n",
    "            if copied_moves:\n",
    "                chosen_move = random.choice(copied_moves[:3])\n",
    "                self.resolve_move(chosen_move)\n",
    "\n",
    "        elif move_name == \"gamble\":\n",
    "            if current_distance <= move[\"range\"]:\n",
    "                outcome = random.choices([\"Heads\", \"Tails\", \"Sides\"], weights=[3000, 3000, 1])[0]\n",
    "                stun_ticks = int(move.get(\"hitstun\", 2.5) / TICK_RATE)\n",
    "                if outcome == \"Heads\":\n",
    "                    target.health -= max(1, target.health / 8)\n",
    "                    target.stunned_until = max(target.stunned_until, self.model.steps + stun_ticks)\n",
    "                elif outcome == \"Tails\":\n",
    "                    self.health -= max(1, self.health / 8)\n",
    "                    self.stunned_until = max(self.stunned_until, self.model.steps + stun_ticks)\n",
    "\n",
    "        elif move_name == \"suplex\":\n",
    "            if current_distance <= move[\"range\"]:\n",
    "                self.model.distance = move[\"range\"]\n",
    "                target.apply_hit(damage=move[\"damage\"], hitstun_sec=move.get(\"hitstun\", 0.3))\n",
    "\n",
    "        elif move_name == \"animal_instinct\":\n",
    "            if current_distance <= move[\"query_radius\"]:\n",
    "                self.active_instinct = ActiveAnimalInstinct(\n",
    "                    owner=self, dot_dmg=move[\"base_dot_damage\"], interval_sec=move[\"dot_interval\"],\n",
    "                    max_ticks=move[\"max_ticks\"], hitbox_r=move[\"hitbox_radius\"], start_tick=self.model.steps\n",
    "                )\n",
    "\n",
    "        elif move_name == \"give_gifts\":\n",
    "            if current_distance <= move[\"range\"]:\n",
    "                dmg = move[\"damage\"]\n",
    "                hit_success = target.apply_hit(damage=dmg, hitstun_sec=move.get(\"hitstun\", 0.75))\n",
    "                if hit_success:\n",
    "                    self.health = min(self.max_health, self.health + (dmg * move[\"lifesteal_ratio\"]))\n",
    "                    self.model.distance = 5.0\n",
    "\n",
    "        elif move_name == \"breach\":\n",
    "            duration = move.get(\"startup\", 0.3) + move.get(\"endlag\", 0.0)\n",
    "            self.resistant_until = max(self.resistant_until, self.model.steps + int(duration / TICK_RATE))\n",
    "            self.active_breach = ActiveBreach(\n",
    "                owner=self, run_speed=self.run_speed, duration_sec=duration,\n",
    "                range_=move[\"range\"], start_tick=self.model.steps\n",
    "            )\n",
    "\n",
    "        elif move_name == \"vortex\":\n",
    "            self.resistant_until = max(\n",
    "                self.resistant_until,\n",
    "                self.model.steps + int(move[\"channel_duration\"] / TICK_RATE)\n",
    "            )\n",
    "            self.active_vortex = ActiveVortex(\n",
    "                owner=self, dot_dmg=move[\"dot_damage\"], interval_sec=move[\"dot_interval\"],\n",
    "                duration_sec=move[\"channel_duration\"], hit_radius=move[\"range\"],\n",
    "                start_tick=self.model.steps\n",
    "            )\n",
    "\n",
    "        else:\n",
    "            max_effective_range = move.get(\"range\", 0)\n",
    "            if current_distance <= max_effective_range:\n",
    "                dmg = move.get(\"damage\", 0)\n",
    "                hitstun_sec = move.get(\"hitstun\", 0.0)\n",
    "                atk_type = move.get(\"atk_type\")\n",
    "                target.apply_hit(damage=dmg, hitstun_sec=hitstun_sec, knockback_type=atk_type)\n",
    "\n",
    "            endlag_ticks = int(move.get(\"endlag\", 0) / TICK_RATE)\n",
    "            if endlag_ticks > 0:\n",
    "                self.locked_until = self.model.steps + endlag_ticks\n",
    "\n",
    "    def step(self):\n",
    "        if not self.alive():\n",
    "            return\n",
    "\n",
    "        for name in self.cooldowns:\n",
    "            self.cooldowns[name] = max(0, self.cooldowns[name] - 1)\n",
    "\n",
    "        self.stamina = min(self.max_stamina, self.stamina + 1)\n",
    "\n",
    "        if self.model.steps < self.stunned_until:\n",
    "            return\n",
    "\n",
    "        if self.active_instinct and self.active_instinct.is_active():\n",
    "            instinct = self.active_instinct\n",
    "            chase_speed = self.run_speed * 2.0 * TICK_RATE\n",
    "            self.model.distance = max(0, self.model.distance - chase_speed)\n",
    "            if (self.model.steps - instinct.last_tick_applied) >= instinct.interval_ticks:\n",
    "                instinct.last_tick_applied = self.model.steps\n",
    "                target = self.opponent()\n",
    "                if target and target.alive() and self.model.distance <= instinct.hitbox_r:\n",
    "                    target.apply_hit(damage=instinct.dot_dmg)\n",
    "                    instinct.ticks_done += 1\n",
    "            if not instinct.is_active():\n",
    "                self.active_instinct = None\n",
    "            return\n",
    "\n",
    "        if self.active_breach and self.active_breach.is_active(self.model.steps):\n",
    "            breach = self.active_breach\n",
    "            self.model.distance = max(0, self.model.distance - (breach.run_speed * 2.0 * TICK_RATE))\n",
    "            if self.model.distance <= breach.range_:\n",
    "                target = self.opponent()\n",
    "                move = self.moves[\"breach\"]\n",
    "                if target and target.alive():\n",
    "                    target.apply_hit(damage=move[\"damage\"], hitstun_sec=move.get(\"hitstun\", 1.0), knockback_type=move.get(\"atk_type\"))\n",
    "                breach.resolved = True\n",
    "                self.locked_until = self.model.steps\n",
    "            return\n",
    "\n",
    "        if self.active_breach and not self.active_breach.is_active(self.model.steps):\n",
    "            self.active_breach = None\n",
    "\n",
    "        if self.active_vortex and self.active_vortex.is_active(self.model.steps):\n",
    "            vortex = self.active_vortex\n",
    "            if (self.model.steps - vortex.last_tick_applied) >= vortex.interval_ticks:\n",
    "                vortex.last_tick_applied = self.model.steps\n",
    "                target = self.opponent()\n",
    "                if target and target.alive() and self.model.distance <= vortex.hit_radius:\n",
    "                    target.apply_hit(damage=vortex.dot_dmg, knockback_type=\"reverse\")\n",
    "\n",
    "        if self.active_vortex and not self.active_vortex.is_active(self.model.steps):\n",
    "            self.active_vortex = None\n",
    "\n",
    "        if self.pending_move and self.model.steps >= self.pending_resolve_at:\n",
    "            self.resolve_move(self.pending_move)\n",
    "\n",
    "        if self.model.steps < self.locked_until:\n",
    "            return\n",
    "\n",
    "        target = self.opponent()\n",
    "        if target and target.pending_move and self.can_dash():\n",
    "            incoming_move = target.moves.get(target.pending_move, {})\n",
    "            if incoming_move.get(\"atk_type\") == \"heavy\" and self.model.distance <= incoming_move.get(\"range\", 0):\n",
    "                self.perform_dash()\n",
    "                return\n",
    "\n",
    "        if self.opponent_is_invulnerable():\n",
    "            approach_speed = self.walk_speed * TICK_RATE\n",
    "            self.model.distance = max(0, self.model.distance - approach_speed)\n",
    "            return\n",
    "\n",
    "        special_move = self.choose_move()\n",
    "        if special_move:\n",
    "            self.start_move(special_move)\n",
    "            return\n",
    "\n",
    "        m1_ready = (\n",
    "            self.cooldowns.get(\"_m1_cd\", 0) <= 0\n",
    "            and self.stamina >= self.m1_config[\"stamina_cost\"]\n",
    "            and self.model.distance <= self.m1_config[\"range\"]\n",
    "        )\n",
    "        if m1_ready:\n",
    "            self.stamina -= self.m1_config[\"stamina_cost\"]\n",
    "            self.use_m1()\n",
    "            return\n",
    "\n",
    "        if self.stamina > self.max_stamina / 2:\n",
    "            approach_speed = self.run_speed * TICK_RATE\n",
    "            self.stamina -= 1\n",
    "        else:\n",
    "            approach_speed = self.walk_speed * TICK_RATE\n",
    "        self.model.distance = max(0, self.model.distance - approach_speed)\n",
    "\n",
    "\n",
    "class DuelModel(Model):\n",
    "    def __init__(self, crusader_a=\"Gleen\", crusader_b=\"Redd\", seed=None):\n",
    "        super().__init__(seed=seed)\n",
    "        self.distance = 10.0\n",
    "        self.active_fields = []\n",
    "        Crusader(self, crusader_a)\n",
    "        Crusader(self, crusader_b)\n",
    "\n",
    "        self.datacollector = DataCollector(agent_reporters={\"Health\": \"health\", \"Stamina\": \"stamina\"})\n",
    "\n",
    "    def fight_over(self):\n",
    "        return any(not a.alive() for a in self.agents)\n",
    "\n",
    "    def process_active_fields(self):\n",
    "        for field in self.active_fields[:]:\n",
    "            if not field.is_active(self.steps):\n",
    "                self.active_fields.remove(field)\n",
    "                continue\n",
    "            if (self.steps - field.last_tick_applied) >= field.interval_ticks:\n",
    "                field.last_tick_applied = self.steps\n",
    "                current_rad = field.current_radius(self.steps)\n",
    "                target = field.owner.opponent()\n",
    "                if target and target.alive() and self.distance <= current_rad:\n",
    "                    target.apply_hit(damage=field.dot_dmg, hitstun_sec=field.interval_ticks * TICK_RATE)\n",
    "\n",
    "    def step(self):\n",
    "        self.datacollector.collect(self)\n",
    "        self.process_active_fields()\n",
    "        self.agents.shuffle_do(\"step\")\n",
    "\n",
    "\n",
    "if __name__ == \"__main__\":\n",
    "    results = []\n",
    "\n",
    "    NUM_FIGHTS = 10000 # modify number of simulations here\n",
    "    MAX_TICKS = 2000 # modify max match time here\n",
    "    total_sanity_lost = 0.0\n",
    "\n",
    "    for fight_num in range(NUM_FIGHTS):\n",
    "        model = DuelModel(\"Gleen\", \"Redd\")\n",
    "        ticks = 0\n",
    "        while not model.fight_over() and ticks < MAX_TICKS:\n",
    "            model.step()\n",
    "            ticks += 1\n",
    "\n",
    "        winner = None\n",
    "        for agent in model.agents:\n",
    "            total_sanity_lost += agent.sanity_lost\n",
    "            if agent.alive():\n",
    "                winner = agent.crusader_name\n",
    "\n",
    "        results.append({\"fight\": fight_num, \"ticks\": ticks, \"winner\": winner})\n",
    "\n",
    "    wins = {}\n",
    "    for r in results:\n",
    "        key = r[\"winner\"] if r[\"winner\"] else \"draw\"\n",
    "        wins[key] = wins.get(key, 0) + 1\n",
    "\n",
    "    print(f\"Ran {NUM_FIGHTS} fights.\")\n",
    "    for name, count in wins.items():\n",
    "        print(f\"{name}: {count} wins ({count / NUM_FIGHTS:.1%})\")\n",
    "    print(f\"Average fight length: {sum(r['ticks'] for r in results) / NUM_FIGHTS:.1f} ticks\")\n",
    "    print(f\"Estimated Developer Sanity Lost across {NUM_FIGHTS} matches: {total_sanity_lost:.1f} points\")"
   ]
  },
