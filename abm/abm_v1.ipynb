    "import random\n",
    "from mesa import Agent, Model\n",
    "from mesa.datacollection import DataCollector\n",
    "\n",
    "TICK_RATE = 0.1\n",
    "\n",
    "KNOCKBACK_DISTANCES = {# knockback specs; not perfect, since these derive from stud amounts i estimated to fit the 1D simulations here\n",
    "    \"none\": 0,\n",\n",
    "    \"light\": 2.5,\n",
    "    \"medium\": 10.0,\n",
    "    \"heavy\": 50.0, # fun fact: this is roughly equivalent to the full displacement of a main/front dash\n",
    "    \"reverse\": -15\n",
    "}\n",
    "\n",
    "DASH_CONFIG = {# limitation: this only emulates the main dash and does not include the aux dash, since i didn't deem the latter important at the time\n",
    "    \"stamina_cost\": 5,\n",
    "    \"cooldown\": 8,\n",
    "    \"invuln_duration\": 0, # main dashes have no i-frames, but this field is here in case i ever decide to change that\n",
    "    \"distance\": 50, # estimation of the main/front dash's displacement, which isn't perfect for the same reason as the knockback distances\n",
    "}\n",
    "\n",
