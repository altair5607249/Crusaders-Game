    "        \"animal_instinct\": {\"base_dot_damage\": 8, \"dot_interval\": 0.3, \"max_ticks\": 5, \"query_radius\": 20, \"hitbox_radius\": 8, \"cooldown\": 27.0, \"stamina_cost\": 30, \"range\": 20, \"startup\": 0.4, \"endlag\": 0, \"tag\": \"combo_starter\", \"tracking\": True},\n",
